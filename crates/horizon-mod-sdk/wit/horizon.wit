/// The contract between Horizon and its mods (docs/mods.md).
///
/// A mod is a WebAssembly component targeting the `mod` world. Each imported
/// interface but `log` is a capability: the mod's manifest lists the ones it
/// uses, the player sees them before turning the mod on, and the game refuses
/// a component that imports one its manifest does not declare.
package horizon:mods@0.1.0;

/// The mod's log, in the game's log under the mod's id. Always granted.
interface log {
    enum level {
        debug,
        info,
        warn,
        error,
    }
    /// One line in the game's log as `[mod <id>] message`, at that level.
    write: func(level: level, message: string);
}

/// Capability `game-read`: the local player, the world clock and the block
/// or living entity the player looks at.
interface game {
    record player {
        /// Feet position, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// Degrees, as F3 shows them.
        yaw: f32,
        /// Degrees: -90 looks straight up, 90 straight down.
        pitch: f32,
        /// Hit points as vanilla counts them: 20 is full health without effects.
        health: f32,
        /// 0 to 20, as the hunger bar.
        food: u32,
        /// `minecraft:overworld`, `minecraft:the_nether`, ...
        dimension: string,
    }
    record clock {
        /// Ticks since the world was created.
        game-time: u64,
        /// 24000 ticks per day; 0 is 6:00 on the first day.
        day-time: u64,
    }
    /// None on the title screen.
    get-player: func() -> option<player>;
    /// None on the title screen.
    get-clock: func() -> option<clock>;
    /// A block along the player's view.
    record hit {
        /// The block hit.
        block-x: s32,
        block-y: s32,
        block-z: s32,
        /// The point on its face where the view meets it.
        x: f64,
        y: f64,
        z: f64,
        /// `minecraft:stone`, ...
        block: string,
    }
    /// The first block along the player's view (fluids pass), up to
    /// `distance` blocks (at most 1024; past the loaded chunks, across the
    /// distant terrain when LOD Distance is on), as of this tick. None when
    /// nothing is hit, and on the title screen.
    raycast: func(distance: f32) -> option<hit>;
    /// A living entity under the crosshair, including players and content mobs.
    record entity-hit {
        /// The entity type's namespaced id.
        kind: string,
        /// Custom name, player name, or localized type name.
        name: string,
        /// Current and computed maximum hit points (20 is ten hearts).
        health: f32,
        max-health: f32,
        /// Feet position, in blocks.
        x: f64,
        y: f64,
        z: f64,
    }
    /// API level 16: nearest loaded living entity along the view, before
    /// any block, within distance (at most 1024). None outside a world.
    /// Health is the real value known to this client as of this tick.
    raycast-entity: func(distance: f32) -> option<entity-hit>;
    /// API level 17: which world the player is in, for a mod that keeps
    /// something per world (waypoints): `sp:<save folder>` in single player,
    /// `mp:<address>` on a server (`mp:lan` for a LAN game found on the
    /// network). None on the title screen.
    world-id: func() -> option<string>;
}

/// Capability `chat`: messages only the local player sees.
interface chat {
    /// Shown in chat after the mod's name, like a system message.
    show: func(text: string);
    /// API level 21: opens the chat box with `text` typed in (at most 256 characters, cursor at the
    /// end), as if the player had opened chat and typed it: they edit it and send it, or close it.
    /// Nothing is sent by the mod. Closes the mod's own open screen first. Ignored when there is no
    /// world, or when chat is hidden in the player's settings (as the chat key is).
    open: func(text: string);
}

/// Capability `hud`: one panel of text lines per mod, drawn by the game
/// every frame until the mod changes or clears it (no call per frame).
interface hud {
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }
    record line {
        /// Plain text, up to 256 characters.
        text: string,
        /// 0xRRGGBB.
        color: u32,
    }
    /// Replaces the mod's panel: up to 16 lines in that corner of the screen.
    set-panel: func(corner: corner, lines: list<line>);
    /// Removes the mod's panel.
    clear: func();
}

/// Capability `storage`: a per-mod folder of small key/value files, quota'd
/// (docs/mods.md). Keys are `[a-z0-9_.-]{1,64}`, one path segment.
interface storage {
    /// None if `key` has never been `set`, or the key is not well-formed.
    get: func(key: string) -> option<list<u8>>;
    /// Errs on a malformed key or over quota (bytes for the whole mod).
    set: func(key: string, value: list<u8>) -> result<_, string>;
    /// No error if `key` was already absent.
    delete: func(key: string);
}

/// Capability `command`: vanilla commands run as the player, with the
/// player's permissions, after the hook call returns (8 per call). A mod's
/// own commands are not run this way.
interface command {
    /// `line` without its slash; its feedback goes to the chat as if typed.
    run: func(line: string);
    /// `lines` (each without its slash, at most 256 a call) as `run` does,
    /// but with nothing in the chat: no feedback and no failure. In single
    /// player and on Horizon's servers, each runs exactly as the player
    /// typing it would (the same rights), in order, 64 a tick, and the
    /// server logs one line a batch; one that carries a chat message (`say`,
    /// `msg`) is refused. On any other server they go as chat commands, and
    /// there their feedback shows: a mod running many should say so.
    run-quiet: func(lines: list<string>);
    /// API level 20: server mods' commands as the player typing them, with replies and
    /// failures discarded. At most 16 lines a call and 64 a tick per mod, without slashes.
    /// Vanilla names and unregistered commands are dropped. Works in single player and on
    /// supporting Horizon servers; other servers (including older Horizon) drop them silently.
    run-mod-quiet: func(lines: list<string>);
}

/// Capability `ui`: widgets the game draws with its own menus' widgets, for
/// a screen the mod owns and a settings page in Options > Mods. Layout and
/// drawing are the game's: a mod says what its widgets hold, never where
/// they sit or how they look, and the game clips everything it is handed.
interface ui {
    /// A line of text.
    record text-widget {
        /// The mod's own name for the widget; `ui-events` calls echo it.
        id: u32,
        /// Up to 256 characters.
        text: string,
        /// 0xRRGGBB; 0 is the menus' white.
        color: u32,
    }
    /// An item's icon and a name beside it, as recipe viewers show them.
    record item-widget {
        /// The mod's own name for the widget.
        id: u32,
        /// `minecraft:diamond`, `<mod>:<path>`; an unknown id draws a "?".
        item: string,
        /// The name shown beside the icon (empty: the item's own).
        name: string,
    }
    /// Rows the player picks one of, as an options page lists choices: a
    /// pick is `ui-events::select`, `selected` is the row to mark now.
    record list-widget {
        /// The mod's own name for the widget; `ui-events::select` echoes it.
        id: u32,
        /// The rows' texts, at most 512, each up to 256 characters.
        rows: list<string>,
        /// The row to mark as the current choice, if any.
        selected: option<u32>,
    }
    /// A thing on a mod's screen or settings page.
    /// A button as the options pages have them (200 × 20): a click is
    /// `ui-events::select(id, 0)`. Mods cycle its label for a choice
    /// ("Corner: Top Left").
    record button-widget {
        /// The mod's own name for the widget.
        id: u32,
        /// Up to 256 characters.
        label: string,
    }
    variant widget {
        /// Text the player reads.
        text(text-widget),
        /// A button.
        button(button-widget),
        /// An item's icon and name.
        item(item-widget),
        /// Rows the player picks from.
        %list(list-widget),
    }
    /// A screen the mod owns: a title over widgets stacked down the middle,
    /// the Done button the game adds, and Esc to leave it.
    record screen {
        /// Its title, up to 256 characters.
        title: string,
        /// Its widgets, in order, at most 64.
        widgets: list<widget>,
    }
    /// Show `screen` over the game; a second call while it is open replaces
    /// it. Only the last call of one hook counts.
    open-screen: func(screen: screen);
    /// Close the mod's screen when it is open (the mod hears no `closed`
    /// for this: it was its own doing).
    close-screen: func();
    /// The mod's page in Options > Mods, reached from a settings button on
    /// its row: the widgets it shows, an empty list for no page. The player
    /// opening the page is `ui-events::settings-opened`: push fresh widgets
    /// then; later calls update the page while it shows.
    set-settings: func(widgets: list<widget>);
}

/// What the game calls on a mod that shows widgets (capability `ui`):
/// what the player did with them.
interface ui-events {
    /// A row of one of the mod's `list` widgets was picked: the widget's
    /// `id` and the row, on the screen or the settings page that showed it.
    select: func(id: u32, row: u32);
    /// The player left the mod's screen (Esc or Done); not for a screen the
    /// mod closed itself or one that went away with the mod.
    closed: func();
    /// The player opened the mod's settings page in Options > Mods: call
    /// `ui::set-settings` now to fill it with fresh widgets.
    settings-opened: func();
    /// API level 18: pointer action on the mod's canvas screen.
    enum pointer-kind { down, up, drag, move }
    /// GUI pixels from the window top left; buttons 0 left, 1 right, 2 middle.
    /// Drag is movement with a button held. Missing exports are ignored.
    pointer: func(kind: pointer-kind, x: f32, y: f32, button: u32);
    /// Wheel at GUI coordinates; positive steps away from the player.
    scroll: func(x: f32, y: f32, steps: f32);
    /// A key.keyboard.* key pressed or released on the canvas screen.
    /// Escape closes the screen instead. Missing exports are ignored.
    screen-key: func(key: string, down: bool);
}

/// API level 22. Capability `container` (experimental: also list it in
/// `experimental`): inspect and click the open survival/container screen.
/// Creative inventory is excluded. Calls are synchronous: state after click
/// includes client prediction, and the normal container-click packet is sent.
interface container {
    enum part { player-main, hotbar, container, crafting-output, armor, offhand, other }
    record stack {
        /// Namespaced item id. Count is not part of same-key.
        item: string,
        count: u32,
        /// The item's component-aware maximum stack size.
        max-stack: u32,
        /// Opaque item + components identity, equal for stacks that can merge.
        /// Valid during this game session; never persist it.
        same-key: u64,
    }
    record slot {
        /// Opaque slot index for click and pointer/scroll events, stable while this menu is open.
        index: u32,
        /// Top left of the 16x16 item box, in GUI pixels from the window top left.
        x: f32,
        y: f32,
        /// Empty string and count 0 for an empty slot; same-key is then 0.
        item: string,
        count: u32,
        /// min(slot maximum for the item, item maximum). For an empty slot,
        /// uses the carried item, or the ordinary 64-stack limit with no carried item.
        max-stack: u32,
        same-key: u64,
        part: part,
        /// Whether the slot may accept the carried item (or its own item with an
        /// empty cursor; an ordinary stack for an empty slot). This is the slot's
        /// placement rule, not a test of remaining space. Output slots are false.
        accepts-item: bool,
    }
    record container-state {
        slots: list<slot>,
        carried: option<stack>,
        /// Container background rectangle, in GUI pixels from the window top left.
        x: f32,
        y: f32,
        width: f32,
        height: f32,
    }
    /// None without an open container screen, including creative inventory.
    /// Reads the live menu, including clicks earlier in the same callback.
    state: func() -> option<container-state>;
    /// A real slot click: button 0 left or 1 right; shift selects QUICK_MOVE,
    /// otherwise PICKUP. Invalid slots/buttons and closed screens are ignored.
    /// At most 256 mutations per hook. Shift latches do not apply: `shift` alone decides. Uses the player's prediction
    /// and network path in single player, LAN and multiplayer alike.
    click: func(slot: u32, button: u32, shift: bool);
    /// Take over the press in progress (either button). Stop vanilla quick craft
    /// without sending it, and suppress that button's coming release click.
    /// Works in pointer(down), before vanilla starts the drag. No button down:
    /// no-op. Screen close clears the takeover and pending release suppression.
    take-drag: func();
    /// Treat the player's container clicks and the pointer events' shift as
    /// Shift-held while on (not `click`, whose `shift` is used as given).
    /// Per mod, ORed together; survives screen changes, cleared on unload/stop.
    set-shift-latch: func(on: bool);
    /// Set/replace a 20x20 slot-style button, relative to the container background's
    /// top left in GUI pixels. At most 8 per mod; further ids are ignored. Finite
    /// offsets only. Item icon; lit adds a gold frame; tooltip on hover (256 chars).
    /// Click/tap fires container-events.button(id) and consumes press and release.
    /// Kept across screens until cleared or the mod stops. Unknown icons draw nothing.
    set-screen-button: func(id: u32, dx: f32, dy: f32, icon: string, lit: bool, tooltip: string);
    /// Remove this mod's button; an unknown id is ignored.
    clear-screen-button: func(id: u32);
}

/// Optional API level 22 exports for capability `container`. Each missing
/// function is ignored, including mods built before this interface existed.
interface container-events {
    enum pointer-kind { down, up, drag }
    /// Mouse and touch, synchronously BEFORE vanilla handles the event.
    /// Window GUI pixels; button 0 left, 1 right, 2 middle. Slot uses state().
    /// Shift includes physical Shift and every running mod's shift latch.
    pointer: func(kind: pointer-kind, x: f32, y: f32, button: u32, slot: option<u32>, shift: bool);
    /// Wheel and two-finger touch scroll, before vanilla; positive away from
    /// the player. First mod returning true consumes; later mods are not called.
    scroll: func(x: f32, y: f32, steps: f32, slot: option<u32>) -> bool;
    /// The player clicked/tapped one of this mod's screen buttons.
    button: func(id: u32);
    /// A survival or container screen opened (never creative inventory).
    opened: func();
    /// The container screen closed; state() is now None.
    closed: func();
}

/// Capability `input` (experimental: the manifest needs
/// `experimental = ["input"]`): the use button on items the mod claims, and
/// the mod's own keys. Events wait for `poll`, at most 256.
interface input {
    use render.{corner};
    /// API level 27: assistance for controller and touch look.
    record aim-assist {
        /// Entity ids, "*" (every mob but players) or "#hostile" (monsters); at most 32 entries.
        targets: list<string>,
        /// Blocks, clamped by the host to 2..32.
        range: f32,
        /// Degrees from the look direction, clamped to 1..20.
        cone: f32,
        /// 0..0.9 slowdown inside the cone.
        slowdown: f32,
        /// Degrees per second toward the target, 0..60, only while the player turns.
        pull: f32,
        /// Apply to controller look.
        controller: bool,
        /// Apply to touch look (finger on the look area).
        touch: bool,
    }
    /// API level 27: replaces this mod's aim assist; none turns it off. Several mods: each field
    /// takes its weakest value (enabled only if every mod that set it enabled it).
    /// Targets must match every mod's list. Errors leave the previous config intact.
    set-aim-assist: func(config: option<aim-assist>) -> result<_, string>;
    enum look-device-kind { mouse, controller, touch }
    /// API level 27: the device that turned the view last frame, so a settings page can show
    /// the right preview text. Defaults to mouse; unchanged until another look movement.
    look-device: func() -> look-device-kind;
    /// API level 20: a square button above the game's touch controls.
    record touch-button {
        /// Up to four characters; also the fallback for an unknown icon item.
        label: string,
        /// A namespaced item id, drawn at 1x (16x16) instead of the label.
        /// Malformed ids are errors; an unknown item falls back to the label.
        icon: option<string>,
        anchor: corner,
        /// Offset inward from the corner, in GUI pixels.
        dx: f32,
        dy: f32,
        /// Side in GUI pixels, clamped to 16..64.
        size: f32,
        lit: bool,
    }
    /// API level 20: set/remove a button for a registered key (at most four per mod).
    /// A finger sends key-down/key-up and consumes the touch. Clamped fully on screen,
    /// including the small button's outer selection ring. Hit area at least 24x24, centred.
    /// Game-mode slot artwork, or a plain plate under 20 px; lit adds a gold frame.
    /// Player touch-layout overrides win over the anchor/offset. Removing an
    /// explicit button restores the key's automatic button.
    set-touch-button: func(name: string, button: option<touch-button>) -> result<_, string>;
    /// API level 24: whether a registered key's automatic touch button (one for a key with no
    /// `set-touch-button`) starts shown. Automatic buttons start hidden unless the mod asks;
    /// the player's own choice (the mod's settings page or Edit Touch Layout) always wins.
    set-auto-button-shown: func(name: string, shown: bool) -> result<_, string>;
    /// API level 25: when a registered key's own or automatic touch button shows by default.
    record touch-context {
        /// Ride one of these entity ids: "*" any mount, "ns:*" any in a namespace.
        /// Empty means no riding condition. At most 32 validated resource ids or wildcards.
        riding: list<string>,
        /// Hold one of these item ids in the main hand: "*" anything, "ns:*" a namespace.
        /// Empty means no holding condition. At most 32 validated resource ids or wildcards.
        holding: list<string>,
    }
    /// API level 25: set/clear the registered key's default touch visibility context.
    /// Both nonempty lists must match; none clears it. The player's Show choice
    /// (Always/Riding/Never) wins. Automatic buttons still start hidden unless opted in
    /// with set-auto-button-shown. Errors leave the previous context intact.
    set-touch-button-context: func(name: string, context: option<touch-context>) -> result<_, string>;
    /// API level 20: whether the player is using the touch screen (the game's touch controls show
    /// while playing). It stays true on screens, so a mod can offer touch buttons on its own.
    touch-active: func() -> bool;
    /// The main hand's stack.
    record held-item {
        /// `minecraft:spyglass`, `<mod>:<path>`.
        id: string,
        count: u32,
        /// The hotbar slot, 0 to 8.
        slot: u32,
    }
    record item-use {
        item: held-item,
        /// Game ticks the button was held (0 on `use-start`).
        ticks: u32,
    }
    variant event {
        /// The use button went down with a claimed item in the main hand.
        /// The game does nothing else with the click: no placing, no eating,
        /// no swing.
        use-start(item-use),
        /// It came up again, or the item left the hand, or a screen opened.
        use-stop(item-use),
        /// A key `register-key` named went down or up while playing (no
        /// screen open). The game's own mapping on that key still runs. A
        /// screen opening lets every held key up.
        key-down(string),
        key-up(string),
        /// Mouse wheel steps while the mod holds the wheel (`claim-wheel`):
        /// positive away from the player, as the hotbar reads them.
        wheel(f32),
    }
    /// The items whose use the mod handles instead of the game, by id (at
    /// most 64). Replaces the previous list.
    claim-items: func(ids: list<string>);
    /// A key of the mod's: `name` comes back in `key-down` and `key-up`,
    /// `label` says what it does, `key` is the key as options.txt writes
    /// it (`key.keyboard.r`), the default: the player can bind another
    /// one on the mod's page in Options > Mods, and that one wins. At most
    /// 16; an unknown key is an error. While touch controls are shown, keys
    /// without set-touch-button get automatic 20px slot buttons, in registration
    /// order down the right side. The player can move or hide them in Edit Touch Layout.
    /// Controller Settings > Bindings lists every registered key, unbound by default.
    /// A player-chosen button or two-button combination sends the same key-down/key-up
    /// events while playing, independently of the keyboard and touch bindings.
    register-key: func(name: string, label: string, key: string) -> result<_, string>;
    /// The main hand's stack, as of this tick; none when it is empty.
    held: func() -> option<held-item>;
    /// The events since the last call, oldest first.
    poll: func() -> list<event>;
    /// Takes the mouse wheel while playing (true) or gives it back: while
    /// taken, its steps are the mod's `wheel` events and the hotbar doesn't
    /// move. The game gives it back when the mod stops.
    claim-wheel: func(on: bool);
    /// A mapping as the player has bound it.
    record mapping-state {
        /// The bound key's name as Controls shows it: `W`, `Space`, `LMB`.
        label: string,
        /// Held down now (as of this frame for a mod with a `frame` hook,
        /// else this tick).
        down: bool,
    }
    /// A movement or click mapping as the player has bound it: `key.forward`,
    /// `key.left`, `key.back`, `key.right`, `key.jump`, `key.sneak`,
    /// `key.sprint`, `key.attack` or `key.use`. None for another name.
    mapping: func(name: string) -> option<mapping-state>;
    /// Clicks of the attack and use buttons in the last second.
    clicks-per-second: func() -> tuple<u32, u32>;
}

/// Capability `render` (experimental: the manifest needs
/// `experimental = ["render"]`): shapes the game draws for the mod with its
/// own renderer, kept until the mod replaces them (no call per frame). A mod
/// never supplies shader code.
interface render {
    /// A world-space segment, in blocks; whole numbers are block corners.
    record world-line { x1: f64, y1: f64, z1: f64, x2: f64, y2: f64, z2: f64 }
    /// API level 20: replace up to 4096 segments, at the block outline's width.
    /// ARGB color is depth tested; hidden-color draws only occluded parts (alpha zero hides).
    /// Hidden with F1; cleared on stop and leaving the world. Empty removes them.
    set-world-lines: func(lines: list<world-line>, color: u32, hidden-color: u32);
    /// A corner of the screen, as `hud`'s panels use them.
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }
    /// A rectangle in GUI pixels: the top left corner and the size.
    record rect {
        x: f32,
        y: f32,
        w: f32,
        h: f32,
    }
    /// A point in GUI pixels from the screen's top left.
    record point {
        x: f32,
        y: f32,
    }
    record fill-shape {
        rect: rect,
        /// 0xAARRGGBB.
        color: u32,
    }
    /// Any four-cornered shape (a wheel's segment, an arrow): the corners
    /// in order round it.
    record quad-shape {
        corners: tuple<point, point, point, point>,
        /// 0xAARRGGBB.
        color: u32,
    }
    record sprite-shape {
        /// One of the game's GUI sprites, as `gui/sprites/` names them
        /// (`hud/heart/full`, `widget/button`), the resource packs' versions
        /// included, drawn over `rect` as vanilla draws it: nine-sliced when
        /// its `gui.scaling` says so (`tooltip/frame`, `widget/button`: the
        /// borders keep their size), stretched otherwise. An unknown one
        /// draws nothing.
        sprite: string,
        rect: rect,
        /// A tint, 0xAARRGGBB: 0xFFFFFFFF draws it as it is.
        color: u32,
    }
    record item-shape {
        /// `minecraft:diamond`, `<mod>:<path>`; an unknown one draws nothing.
        item: string,
        /// The icon's top left.
        at: point,
        /// 1.0 is the hotbar's 16 × 16.
        scale: f32,
    }
    record text-shape {
        /// Up to 256 characters, one line.
        text: string,
        at: point,
        /// 0xRRGGBB, as `hud`'s lines.
        color: u32,
        /// Centred on `at.x` instead of starting there.
        centered: bool,
        shadow: bool,
    }
    variant shape {
        fill(fill-shape),
        quad(quad-shape),
        sprite(sprite-shape),
        item(item-shape),
        text(text-shape),
    }
    /// Replaces the mod's HUD shapes: up to 1024, drawn every frame in
    /// order over the HUD (after the hotbar, under chat and screens), hidden
    /// with the HUD (F1). An empty list removes them.
    set-hud: func(shapes: list<shape>);
    /// The screen's size in GUI pixels (width, height), as of this tick.
    gui-size: func() -> tuple<f32, f32>;
    /// Shakes the camera: a jolt of `strength` (0 to 1, 1 the hardest) that
    /// fades out over `seconds` (at most 10). Jolts add up to 1. The view
    /// turns, the player doesn't, and the player's Distortion Effects option
    /// scales it (0 turns it off).
    shake: func(strength: f32, seconds: f32);
    /// Replaces the mod's corner panel: shapes in GUI pixels from the top
    /// left of a `width` × `height` box that the game places in `corner`,
    /// stacked with the game's overlays and the other mods' panels (under
    /// the status effects at the top right), as `hud`'s panels are.
    set-corner: func(corner: corner, width: f32, height: f32, shapes: list<shape>);
    /// Removes the mod's corner panel.
    clear-corner: func();
    /// The width of one line of text in GUI pixels, in the HUD's font: exact
    /// for Latin letters (U+0000 to U+024F), 6 per other character.
    text-width: func(text: string) -> f32;
    record frame-rate {
        /// Frames drawn in the last second.
        fps: u32,
        /// The slowest frame's rate, and the 1% low (the 99th percentile
        /// frame time's rate), over the last 5 seconds.
        min: u32,
        low: u32,
    }
    /// The game's frame counter, recomputed twice a second.
    frame-stats: func() -> frame-rate;
    record zoom {
        /// The field of view is divided by it: 1 is none, at most 10.
        factor: f32,
        /// Ease in and out through the game's field-of-view easing, as the
        /// spyglass does, instead of at once.
        smooth: bool,
        /// Mouse turning is multiplied by it while zoomed: 1 keeps the
        /// player's sensitivity, at least 0.05.
        turn: f32,
    }
    /// Zooms the camera until the next call (`factor` 1 ends it), only
    /// while playing: a screen opening or the spyglass's own view (which
    /// wins) leave the camera vanilla's. With several mods, the strongest
    /// zoom counts.
    set-zoom: func(zoom: zoom);
    record minimap {
        corner: corner,
        /// Its side in GUI pixels, 16 to 256.
        size: f32,
        /// World blocks per map pixel, 0.5 to 4; the map is 128 × 128 pixels.
        blocks-per-pixel: f32,
        /// The map turns with the player, who faces up, and an N on its rim
        /// marks north. Otherwise north is up and the player's arrow turns.
        rotate: bool,
        /// Round, the corners left clear; otherwise square.
        round: bool,
    }
    /// Shows a map of the world around the player in `corner`, stacked with
    /// the game's overlays and the mods' panels, until the next call (none
    /// hides it). It looks like a map item: vanilla's map colours with their
    /// height shading and water depth, and the player's arrow. Underground,
    /// under a roof and in the Nether it maps the floor around the player's
    /// height. The game keeps the map's tiles and refreshes them within its
    /// own frame budget; hidden, they are dropped. One map shows at a time:
    /// the first loaded mod's.
    set-minimap: func(minimap: option<minimap>);
    record far-terrain {
        /// How far the distant terrain reaches, in chunks: 64 to 1024. On
        /// integrated graphics other than Apple's the game caps it lower.
        distance: u32,
        /// Coarser far tiles, as the Far Detail setting's Reduced: 2 to 4 ms
        /// less GPU time per frame on integrated graphics.
        reduced: bool,
    }
    /// Draws the world beyond the render distance as distant terrain, out to
    /// `distance` chunks, until the next call (none ends it). The game builds
    /// it on its own workers, from the chunks already loaded or saved and,
    /// where nobody has been, from the world's generator; the simulation
    /// distance doesn't change. Only worlds whose generator the game has
    /// (single player and a LAN world you host) show it. The player's own LOD
    /// Distance setting, when on, wins. One far terrain shows at a time: the
    /// first loaded mod's.
    set-far-terrain: func(far-terrain: option<far-terrain>);
}

/// Capability `render` (experimental), API level 17: the mod's own pixels on
/// the HUD. Images live on one shared atlas page the game draws from; a mod
/// fills them with `update-image` and shows them in a corner box with
/// `set-corner`, beside the `render` shapes. Also the frame budget a mod
/// with heavy `frame` work asks for, and how much of it is left.
interface canvas {
    use render.{corner, rect, point, fill-shape, quad-shape, sprite-shape, text-shape};
    /// An image of the mod's, from `create-image`.
    type image = u32;
    /// A new image of `width` × `height` texels (each side 1 to 1024; at most
    /// 1024 × 1024 texels for all of a mod's images together), on the shared
    /// mod-image atlas page. It starts transparent. An error when a side is
    /// out of range, the mod's share is used up or the page is full.
    create-image: func(width: u32, height: u32) -> result<image, string>;
    /// Replaces the texels from (`x`, `y`) to (`x + width`, `y + height`) of
    /// `image` with `rgba` (`width × height × 4` bytes, straight alpha, rows
    /// top first). Shown from the next frame. At most 1024 KiB a frame for
    /// each mod: past it, an error and nothing changes. An unknown image, a
    /// rectangle outside it or the wrong number of bytes is an error.
    update-image: func(image: image, x: u32, y: u32, width: u32, height: u32, rgba: list<u8>) -> result<_, string>;
    /// Frees `image` and its place on the page; an unknown one is ignored.
    /// A mod's images go when it stops.
    drop-image: func(image: image);
    /// Part of an image, drawn stretched into a rectangle.
    record image-shape {
        image: image,
        /// The texels of the image drawn (clipped to it).
        src: rect,
        /// Where, in GUI pixels from the box's top left.
        dst: rect,
        /// A tint, 0xAARRGGBB: 0xFFFFFFFF draws the image as it is, a lower
        /// alpha fades it.
        tint: u32,
        /// Clipped to the circle inscribed in `dst` (a round minimap).
        round: bool,
    }
    /// What a canvas corner box holds.
    variant shape {
        image(image-shape),
        fill(fill-shape),
        quad(quad-shape),
        sprite(sprite-shape),
        text(text-shape),
    }
    /// Replaces the mod's canvas box: shapes in GUI pixels from the top left
    /// of a `width` × `height` box that the game places in `corner`, stacked
    /// with the game's overlays, the mods' panels and their `render` corner
    /// panels, under the status effects at the top right; hidden with the
    /// HUD (F1), and the top left gives way to the debug screen (F3). Up to
    /// 1024 shapes; an image shape of an unknown image draws nothing.
    set-corner: func(corner: corner, width: f32, height: f32, shapes: list<shape>);
    /// API level 18: replaces the mod's canvas box, offset inward from the
    /// anchor in GUI pixels, clamped fully on screen. Same limits as
    /// set-corner; independent of corner stacking and hidden with F1.
    set-placed: func(anchor: corner, dx: f32, dy: f32, width: f32, height: f32, shapes: list<shape>);

    /// API level 21: a finger on the drawn canvas box sends key-down for this
    /// input.register-key name, and lifting sends key-up. Only while playing
    /// with touch controls shown; consumes the touch. Game and mod touch
    /// buttons win overlaps. none restores the default of taking no touches.
    /// An unknown key name is an error.
    set-box-key: func(name: option<string>) -> result<_, string>;
    /// API level 18: opens the mod's full-window canvas (capabilities ui and
    /// render). Up to 4096 shapes in GUI pixels from the window top left,
    /// clipped to the window. Hides its HUD box; Escape sends ui-events.closed.
    open-canvas-screen: func(title: string, shapes: list<shape>);
    /// Replaces the open canvas screen's shapes; ignored without a screen.
    set-canvas-screen: func(shapes: list<shape>);
    /// Closes the mod's canvas screen without a closed event.
    close-canvas-screen: func();
    /// Removes the mod's canvas box.
    clear-corner: func();
    /// Asks for a CPU budget for each `frame` call, in microseconds: 100 by
    /// default, at most 500, or 4000 while this mod's canvas screen is open.
    /// Remembers the request: closing the screen immediately restores the
    /// 500 maximum; reopening reapplies a larger request. Thermal pressure
    /// may limit screens to 500 too. Returns what is granted now (the Mods
    /// page shows it). The frame hook's hard fuel cap always wins, with
    /// headroom to return. The mod has no clock: `work-left` says how much
    /// of the soft budget is left.
    request-frame-budget: func(micros: u32) -> u32;
    /// How much of this hook call's budget is left, about 1000000 at its
    /// start and 0 once it is spent: a mod that works `while work-left() >
    /// reserve` keeps to its budget. In `frame` calls the budget is the
    /// granted one, measured on this device as the mod runs (host calls
    /// included); in other hooks it is the hook's own fuel. Spending past it
    /// is allowed up to the hook's fuel, past which the mod is stopped.
    work-left: func() -> u64;
}

/// Capability `world-read` (experimental), API level 17: the blocks, biomes
/// and light the player's game has loaded, as the window shows them, in
/// single player and on any server alike (nothing the server didn't send),
/// read in whole chunks for minimaps; and the block table and textures of
/// the loaded resource packs.
interface client-world {
    /// API level 20: the client-loaded block state, e.g. minecraft:oak_log[axis=y].
    /// None for unloaded chunks and on the title screen.
    block-at: func(x: s32, y: s32, z: s32) -> option<string>;
    /// The player's dimension.
    record dimension-info {
        /// `minecraft:overworld`, ...
        id: string,
        /// Its lowest block y and its height in blocks.
        min-y: s32,
        height: u32,
        /// It has a roof (the Nether's bedrock ceiling).
        ceiling: bool,
    }
    /// Where a face's colour comes from, besides its texture.
    enum tint-source {
        none,
        grass,
        foliage,
        dry-foliage,
        water,
        /// The state's `constant-tint` (a lily pad, a redstone wire's power, a stem's age).
        constant,
    }
    /// What a block state's model draws on one side: its first face there.
    record face {
        /// Its texture, an index into `block-states.sprites`; 0xFFFFFFFF when
        /// the side draws nothing.
        sprite: u32,
        tint: tint-source,
    }
    /// Every block state the game knows, as the loaded resource packs draw
    /// them (`block-table`). The lists by state are indexed by state id
    /// (`columns`' ids).
    record block-states {
        /// Changes when the resource packs reload: build colours again then.
        version: u64,
        /// The blocks, `minecraft:grass_block`, ...
        blocks: list<string>,
        /// The texture names faces use, `block/grass_block_top` (a mod's with
        /// its namespace), for `texture`.
        sprites: list<string>,
        /// Each state's block, an index into `blocks`.
        state-block: list<u16>,
        /// Each state's facts, bits from the lowest: air (1), drawn as nothing
        /// (2: a barrier, light), water (4), lava (8), waterlogged (16),
        /// see-through like glass or leaves (32), no collision like a plant
        /// (64), a full face on top (128); and the light it gives (0 to 15) << 8.
        state-flags: list<u16>,
        /// What each state draws facing up, and facing south; a model with
        /// nothing flat on either (a flower's crossed planes) gives its
        /// first face for both.
        state-top: list<face>,
        state-side: list<face>,
        /// Each state's tint for tint source `constant`, 0xRRGGBB (0 when none).
        constant-tint: list<u32>,
        /// Each state's vanilla map colour, 0xRRGGBB (0 for none): a fallback.
        map-color: list<u32>,
    }
    /// A texture's pixels: its first frame when it is animated, at the size
    /// the game holds block textures (every one the same).
    record texture-pixels {
        width: u32,
        height: u32,
        /// `width × height × 4` bytes, straight alpha, rows top first.
        rgba: list<u8>,
    }
    /// Which block of each column `columns` reads.
    variant layer {
        /// The top block (what is under the open sky).
        surface,
        /// The floor under this height: the first block going down from it
        /// (it included), as the game's own minimap maps caves and the Nether.
        below(s32),
    }
    /// A chunk's 256 columns, x fastest: column `z * 16 + x`.
    record chunk-columns {
        /// The chunk's change counter, as `changes` counts: the same value
        /// means the same blocks.
        revision: u64,
        /// Each column's top block's y in the layer, water and lava
        /// included; -32768 for none (air all the way down).
        tops: list<s16>,
        /// For each column, `depth` state ids from its top block down
        /// (air below the world's bottom).
        states: list<u32>,
        /// Each column's water depth from its top block down (0 when the
        /// top block isn't water), at most 255.
        water: list<u8>,
        /// The light just above each top block: sky light << 4 | block light.
        light: list<u8>,
        /// Each column's grass, foliage and water colours, 0xRRGGBB, three
        /// per column, at its top block's biome (as the game draws them,
        /// before the biome blend).
        tints: list<u32>,
    }
    /// The player's dimension; none on the title screen.
    dimension: func() -> option<dimension-info>;
    /// The block table (about 30000 states: read it in `init` or when its
    /// version changes, not every frame). Empty lists on a game without
    /// block models (a dedicated server).
    block-table: func() -> block-states;
    /// The block table's `version` now, without reading the table: cheap
    /// enough to ask every tick, to know when the packs reloaded.
    table-version: func() -> u64;
    /// A texture by its name in `block-states.sprites`, from the loaded
    /// resource packs (a higher pack's over a lower one's); none for one no
    /// block model uses.
    texture: func(name: string) -> option<texture-pixels>;
    /// The chunks at these chunk coordinates (block x >> 4, z >> 4), each
    /// column's `depth` blocks (1 to 16) from the top in `layer`; none for
    /// a chunk the game hasn't loaded. At most 16 chunks a call: more, or a
    /// depth out of range, is an error.
    columns: func(chunks: list<tuple<s32, s32>>, layer: layer, depth: u8) -> result<list<option<chunk-columns>>, string>;
    /// API level 23: columns after skipping their leading see-through states.
    record prepared-chunk {
        /// As `columns`, with only tops and states changed. Water, light,
        /// tints (including the original top's biome colours) and revision
        /// stay exactly as read; light is not resampled at the lowered top.
        columns: chunk-columns,
        /// 256 counts, x fastest. Zero for an empty column, a solid first
        /// state, or no solid within depth. Otherwise the first solid's index k.
        skips: list<u8>,
        /// Original leading k states for each nonzero skip, top down, in
        /// column order, concatenated without padding. The skips are their
        /// lengths: no per-column lists or allocations. Use these states
        /// with the mod's albedos to compute plant/glass overlay colours.
        skipped-states: list<u32>,
    }
    /// API level 23: replaces this mod's see-through state set (at most
    /// 65536 ids; duplicates allowed). Empty initially; unlisted ids are
    /// solid. Register again after a block-table/looks rebuild. Other mods'
    /// sets are independent. An error leaves the previous set intact.
    set-see-through: func(states: list<u32>) -> result<_, string>;
    /// API level 23: the same order, missing chunks and limits as `columns`.
    /// For each nonempty column, find the first state not in this mod's
    /// see-through set within depth. If its index k > 0, lower the top by k,
    /// shift states up by k and pad with the original deepest state.
    /// k == 0 or no solid found leaves the column unchanged (skip zero).
    /// Fixed-size data stays in flat primitive lists for cheap guest lifting.
    prepared-columns: func(chunks: list<tuple<s32, s32>>, layer: layer, depth: u8) -> result<list<option<prepared-chunk>>, string>;
    /// API level 24: what mines a block, from its loaded tags (content mods' included).
    record harvest-info {
        /// Tools that mine it faster than a hand: any of "pickaxe", "axe", "shovel", "hoe"
        /// (in that order), as the game's own tool rules (content mods' included) decide.
        tools: list<string>,
        /// The lowest material whose tool drops it: "wooden", "stone", "iron", "diamond" or
        /// "netherite"; none when it needs no tool (or no such tool drops it).
        tier: option<string>,
        /// The tool of `tier` that drops it ("pickaxe"...), when there is one.
        tier-tool: option<string>,
        /// It drops nothing unless broken with the right tool.
        needs-tool: bool,
        /// The item in the player's main hand would drop it (true when it needs no tool).
        held-drops: bool,
        /// Its destroy time (hardness); negative for unbreakable.
        hardness: f32,
    }
    /// API level 24: a block id or state's harvest facts, for the player's held item; none
    /// for an unknown block or on the title screen.
    harvest: func(block: string) -> option<harvest-info>;
    /// The chunks within `radius` chunks of the player (at most 64) whose
    /// change counter moved past `since`: changed, loaded or unloaded since
    /// (an unloaded one now reads none), nearest first, at most 4096. Returns
    /// the counter now, for the next call; 0 asks for every loaded chunk.
    changes: func(since: u64, radius: u32) -> tuple<u64, list<tuple<s32, s32>>>;
    /// Light at a block, sky light << 4 | block light; none where no chunk
    /// is loaded.
    light: func(x: s32, y: s32, z: s32) -> option<u8>;
    /// The biome at a block (`minecraft:plains`), as the chunk stores it
    /// (one per 4 × 4 × 4 cell); none where no chunk is loaded.
    biome: func(x: s32, y: s32, z: s32) -> option<string>;
}

/// What the game calls. Only the hooks `init` asks for are ever called.
interface events {
    record registration {
        /// Chat commands, without the slash. A name vanilla already uses is
        /// refused (vanilla's command runs).
        commands: list<string>,
        /// Call `tick` every game tick (20 per second while playing).
        tick: bool,
        /// Call `frame` every rendered frame. Budget: 0.1 ms.
        frame: bool,
        /// Call `chat` for each chat line the player receives.
        chat: bool,
    }
    /// Once, after loading. An error keeps the mod off and is shown.
    init: func() -> result<registration, string>;
    /// Each game tick while in a world, with the game's tick counter.
    tick: func(tick: u64);
    /// Each rendered frame, with the seconds since the last one.
    frame: func(seconds: f32);
    /// `/name args`: ok(some(text)) is shown as feedback, err(text) in red.
    command: func(name: string, args: string) -> result<option<string>, string>;
    /// Each chat line the player receives, as plain text.
    chat: func(text: string);
}

/// Capability `recipes` (experimental): the recipes and items the game
/// knows, for recipe viewers. In single player and on Horizon's servers
/// they are the world's; on any other server they are vanilla 26.3's (a
/// client is sent no others), while `known` follows that server's book.
interface recipes {
    /// An item of `items`, by its index there, with a count and the
    /// components it has beyond the item's own, in vanilla's item syntax
    /// (`[potion_contents={potion:"minecraft:swiftness"}]`), or "".
    record stack {
        item: u32,
        count: u32,
        components: string,
    }
    /// The station a recipe is made at.
    enum kind {
        crafting-shaped,
        crafting-shapeless,
        smelting,
        blasting,
        smoking,
        campfire,
        stonecutting,
        smithing,
        brewing,
    }
    record recipe {
        /// `minecraft:oak_planks`.
        id: string,
        kind: kind,
        /// The recipe book's tab (`crafting_building_blocks`,
        /// `furnace_food`), or "".
        category: string,
        /// Recipes the book shows on one button share a group, or "".
        group: string,
        /// A shaped recipe's grid: `slots` holds its cells row by row.
        /// 0 for the other kinds.
        width: u32,
        height: u32,
        /// Each slot's stacks, any one of which fits; an empty list is an
        /// empty cell. Cooking and stonecutting: the input. Smithing: the
        /// template, the base, the addition. Brewing: the bottle, the
        /// reagent.
        slots: list<list<stack>>,
        /// What it makes; several when that varies (a trim on any armour).
        results: list<stack>,
        /// Cooking: game ticks and experience; 0 for the other kinds.
        cooking-time: u32,
        experience: f32,
        /// The recipe book's id for it (one per way the book shows it), as
        /// `known` lists them; -1 for the kinds the book doesn't show
        /// (campfire, stonecutting, smithing, brewing).
        book-id: s32,
    }
    record item {
        /// `minecraft:diamond`, `<mod>:<path>`.
        id: string,
        /// In the player's language.
        name: string,
        /// Its item tags, without the `#`.
        tags: list<string>,
    }
    /// Every item, in the registry's order: `stack.item` indexes this list.
    items: func() -> list<item>;
    /// Every recipe: the book's in its order, then campfire, stonecutting,
    /// smithing and brewing. They don't change while a world is open.
    all: func() -> list<recipe>;
    /// The `book-id`s of the recipes the player's recipe book holds now.
    known: func() -> list<s32>;
    /// Places a recipe in the open screen's grid as a click in the recipe
    /// book does (`ServerboundPlaceRecipePacket`): the inventory's grid or
    /// a crafting table, furnace, blast furnace or smoker. `all` places as
    /// many as the items allow, as with Shift. Refused while no such screen
    /// is open, for spectators, for a recipe the player's book doesn't hold
    /// and for one that can't be placed; one missing items shows as a ghost
    /// in the grid, as in the book.
    place: func(book-id: s32, all: bool) -> result<_, string>;
    /// Creative mode only: gives the player the stack, as taking it from
    /// the creative inventory does (`ServerboundSetCreativeModeSlot`): the
    /// selected slot first, then the hotbar, then the inventory. The count
    /// is cut to one stack of the item (64, 16 or 1).
    give: func(stack: stack) -> result<_, string>;
}

/// Capability `ui` (experimental): a recipe viewer's panel beside the
/// game's inventory and container screens (not the creative inventory), on
/// the right of the screen. The game draws it with its own widgets and
/// slots, pages it and keeps its search box; the mod says what it holds.
/// The first loaded mod with a panel shows.
interface browser {
    /// An item to show: its id, a count (1 draws none) and its components
    /// beyond the item's own, in vanilla's item syntax, or "".
    record stack {
        item: string,
        count: u32,
        components: string,
    }
    /// A click on an item of the panel, by its index in `set-items`'s list.
    record click {
        index: u32,
        right: bool,
    }
    /// A key the mod registered (`input.register-key`) went down while the
    /// pointer was on an item: a slot of the screen's, or the panel's.
    record item-key {
        key: string,
        stack: stack,
    }
    /// A click on a slot of a recipe the panel shows (`set-recipes`).
    record slot-click {
        /// The recipe's index in `set-recipes`'s list and the slot's in
        /// it; the results come after the slots.
        recipe: u32,
        slot: u32,
        /// The stack the slot showed at that moment.
        stack: stack,
        right: bool,
    }
    variant event {
        clicked(click),
        /// The search box's text, each time the player changes it.
        search(string),
        key(item-key),
        slot-clicked(slot-click),
        /// The action button of the recipe at this index in
        /// `set-recipes`'s list.
        action(u32),
        /// The player turned the recipes' page (`set-recipes`): the index
        /// of the first recipe now shown.
        page(u32),
        /// The back button of `set-recipes`.
        back,
        /// The player picked the tab at this index of `set-recipes`' tabs.
        tab(u32),
    }
    /// How the game lays out a recipe of `set-recipes`.
    enum layout {
        /// A crafting grid of `width` x `height` slots, an arrow and the
        /// result.
        grid,
        /// One input over a flame, an arrow and the result (furnaces,
        /// smokers, campfires).
        cooking,
        /// One input, an arrow and the result (the stonecutter).
        single,
        /// Template, base and addition, an arrow and the result.
        smithing,
        /// A potion and an ingredient, an arrow and the result.
        brewing,
    }
    /// A recipe to show. Each slot, and the result, cycles through its
    /// stacks, one a second; an empty slot shows nothing.
    record recipe-view {
        layout: layout,
        /// The grid's size (`grid` only), at most 3 x 3.
        width: u32,
        height: u32,
        slots: list<list<stack>>,
        results: list<stack>,
        /// A short line under the recipe (a cooking time), or "".
        note: string,
        /// The action button beside it: none, enabled, or shown greyed.
        action: option<bool>,
    }
    /// The panel's items, at most 8192 (an empty list hides the panel).
    set-items: func(items: list<stack>);
    /// Shows these recipes in the panel instead of its items, as many as
    /// fit a page, under `title` and a back button, with a row of `tabs`
    /// (each an icon; `tab` is the selected one) between them; an empty
    /// list of recipes shows the items again. At most 256 recipes and 16
    /// tabs.
    set-recipes: func(title: string, tabs: list<stack>, tab: u32, recipes: list<recipe-view>);
    /// What the player did on the panel since the last poll, at most 256
    /// kept.
    poll: func() -> list<event>;
}

/// API level 19: browser extensions. Data queries need capability `recipes`; all other
/// functions need capability `ui` (experimental).
interface browser-ext {
    /// What the game knows of an item beyond `recipes.items`: from its components, the same for
    /// vanilla and content-mod items.
    record item-fact {
        /// The item's index in `recipes.items`.
        item: u32,
        /// `minecraft:cooking_fuel`: ticks it burns in a furnace, 0 when it is no fuel.
        burn-ticks: u32,
        /// `minecraft:compostable`: the chance one raises a composter's level (0 to 1), 0 when not.
        compost-chance: f32,
        /// `minecraft:repairable`: the items (indexes in `recipes.items`) that repair it in an anvil.
        repaired-by: list<u32>,
    }
    /// Capability `recipes`. One entry per item with any fact; others are left out.
    item-facts: func() -> list<item-fact>;
    /// A recipe whose type the game doesn't know (a mod's own, `iceandfire:dragonforge`), as its file.
    record other-recipe { id: string, kind: string, json: string }
    /// Capability `recipes`. The world's recipes of types `recipes.all` can't express, from its data
    /// and content mods. Empty on servers that are not Horizon (a client is sent no recipe files).
    /// At most 4096, each file at most 16 KiB.
    other-recipes: func() -> list<other-recipe>;
    use recipes.{recipe};
    /// Capability `recipes`. How many recipes `recipes.all` holds.
    recipe-count: func() -> u32;
    /// Capability `recipes`. `count` recipes of `recipes.all` from index `start`, in the same order (fewer at the end, none past it). At most 2048 a call. For big packs, where one `recipes.all` call costs more than a frame's fuel.
    recipes-page: func(start: u32, count: u32) -> list<recipe>;
    use browser.{stack, click, recipe-view};
    /// A slot placed in a custom recipe's box, in GUI px from the box's top left; it cycles through
    /// its stacks like the standard layouts' slots.
    record placed-slot { x: s32, y: s32, stacks: list<stack> }
    /// Text in the box (`color` 0xRRGGBB), drawn with the game's font and shadow.
    record placed-text { x: s32, y: s32, text: string, color: u32 }
    /// One of the game's GUI sprites (`gui/sprites/...` names, e.g. `container/furnace/lit_progress`,
    /// `recipe_book/...`); an unknown name draws nothing.
    record placed-sprite { x: s32, y: s32, sprite: string }
    /// A recipe the mod lays out itself. At most 9 slots, 16 texts, 16 sprites; the box at most 160 x 120.
    /// The panel is 2 to 12 slots (36 to 216 GUI px) wide, about 108 at GUI scale 3 on a 1280 x 720
    /// window: a wider box runs off the screen's edge, so keep boxes narrow.
    record custom-view {
        width: u32,
        height: u32,
        slots: list<placed-slot>,
        %result: option<placed-slot>,
        texts: list<placed-text>,
        sprites: list<placed-sprite>,
        /// The action button beside it (as `browser.recipe-view.action`).
        action: option<bool>,
    }
    variant recipe-entry { standard(recipe-view), custom(custom-view) }
    /// `browser.set-recipes` with custom layouts mixed in. Same limits, same events
    /// (`browser.event.slot-clicked` counts a custom recipe's slots in order, then its result).
    set-recipes: func(title: string, tabs: list<stack>, tab: u32, recipes: list<recipe-entry>);
    variant event {
        /// A click on the bookmark panel's item at this index of `set-bookmarks`.
        bookmark-clicked(click),
    }
    /// A second panel left of the screen's window, as JEI's bookmarks (an empty
    /// list hides it). At most 1024. Hidden while the screen's recipe book is open.
    set-bookmarks: func(items: list<stack>);
    /// Extra tooltip lines for some of a panel's items.
    record item-lines {
        /// The item's index in `browser.set-items` (or `set-bookmarks` for the bookmark panel).
        index: u32,
        lines: list<string>,
    }
    /// Extra tooltip lines under these items' names, for the main panel (`bookmarks` false) or the
    /// bookmark panel. Replaces earlier ones for that panel. At most 8 lines of 128 characters per
    /// item, 8192 items. Dropped when that panel's items change (`set-items` / `set-bookmarks`).
    set-item-lines: func(bookmarks: bool, lines: list<item-lines>);
    /// With true, an empty `browser.set-items` keeps the panel and its search box up.
    keep-empty: func(keep: bool);
    /// What the player did on the bookmark panel since the last poll, at most 256 kept.
    poll: func() -> list<event>;
}

/// Capability `players`, server mods only (manifest `api = "0.3"`,
/// experimental): the players on the server, and messages to them.
interface players {
    record player-damage {
        player: string,
        /// Health plus absorption actually lost, after armor/effects.
        amount: f32,
        /// Registered damage type id.
        source-kind: string,
        attacker-mob: option<u32>,
    }
    /// Last tick's accepted damage, at most 256. Reading does not consume it.
    damage-taken: func() -> list<player-damage>;
    /// Restore health (0..1024), capped by max health; never revive a dead player.
    heal: func(player: string, amount: f32) -> result<_, string>;
    /// A vector or position in blocks, with finite components.
    record point { x: f64, y: f64, z: f64 }
    /// Registry ids, none for an empty slot. Distinct name from equipment (WIT).
    record equipment-slots {
        head: option<string>,
        chest: option<string>,
        legs: option<string>,
        feet: option<string>,
        main-hand: option<string>,
        off-hand: option<string>,
        /// Exactly nine hotbar slots, in order.
        hotbar: list<option<string>>,
    }
    /// The online player's authoritative equipment, including changes by inventory calls.
    equipment: func(player: string) -> option<equipment-slots>;
    /// ItemStack.hurtAndBreak on main_hand or off_hand, including Unbreaking,
    /// creative immunity, inventory sync and the item's break sound/particles.
    damage-item: func(player: string, hand: string, amount: u32) -> result<_, string>;
    /// LivingEntity knockback; dx/dz point away from the attacker. Strength 0..4.
    /// The game applies the player's knockback resistance.
    knockback: func(player: string, strength: f32, dx: f64, dz: f64) -> result<_, string>;
    /// Add velocity in blocks per tick, each axis -4..4; clients receive the motion.
    push: func(player: string, velocity: point) -> result<_, string>;
    /// Yaw and pitch in degrees as F3 shows them; none keeps the player's current view.
    record teleport-target { dimension: string, at: point, yaw: option<f32>, pitch: option<f32> }
    /// Moves an online player like vanilla /tp, including across dimensions,
    /// resetting fall distance and notifying clients. Errors for an offline player,
    /// unknown dimension, non-finite coordinates or angles, or outside the world border.
    teleport: func(player: string, target: teleport-target) -> result<_, string>;
    enum game-mode {
        survival,
        creative,
        adventure,
        spectator,
    }
    record player {
        /// The player's UUID, `xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx`.
        id: string,
        name: string,
        /// Feet position, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// `minecraft:overworld`, `minecraft:the_nether`, ...
        dimension: string,
        game-mode: game-mode,
        /// Hit points as vanilla counts them: 20 is full health without effects.
        health: f32,
    }
    /// The players online, in the order they joined.
    online: func() -> list<player>;
    /// Vanilla's op permission level, 0..4; none when offline.
    /// Single-player with cheats on counts as 4.
    permission-level: func(player: string) -> option<u8>;
    /// Where a player looks.
    record look {
        /// Degrees, as F3 shows them (0 south, 90 west).
        yaw: f32,
        /// Degrees: -90 looks straight up, 90 straight down.
        pitch: f32,
    }
    /// Where an online player looks, by UUID; none when no such player is
    /// online.
    facing: func(player: string) -> option<look>;
    /// The block a player clicked, and its face (down, up, north, south, west, east).
    record block-hit {
        x: s32,
        y: s32,
        z: s32,
        face: string,
    }
    record item-use {
        player: string,
        item: string,
        /// main_hand or off_hand.
        hand: string,
        sneaking: bool,
        target: option<block-hit>,
    }
    /// Item right clicks during the last tick, oldest first, at most 256.
    /// The game's own use of each item still happens. Reading does not consume them.
    item-uses: func() -> list<item-use>;
    record attack {
        player: string,
        item: option<string>,
        /// The mob id used by entities.mobs and entities.near.
        mob: option<u32>,
        target-player: option<string>,
        damage: f32,
    }
    /// Melee hits players landed during the last tick, oldest first, at most 256.
    attacks: func() -> list<attack>;
    /// Apply a registered status effect; zero seconds removes it. Unknown effects
    /// or offline players are errors. Players' clients receive the change.
    add-effect: func(player: string, id: string, seconds: u32, amplifier: u8) -> result<_, string>;
    /// A system message to one player, after the mod's name; false when no
    /// player with that id is online. Up to 8 messages per call.
    tell: func(player: string, text: string) -> bool;
    /// A system message to every player and the server's log, after the
    /// mod's name. Counts toward the same 8 per call.
    broadcast: func(text: string);
    /// Remove up to count by registry id, main hand first, then the rest of
    /// the inventory (including armor and off hand). Creative consumes none
    /// but reports count. The return value and subsequent calls see the real
    /// inventory now; unknown items or offline players are errors.
    take-item: func(player: string, item: string, count: u32) -> result<u32, string>;
    /// Add plain items to a player's inventory; drop overflow at their feet
    /// before that dimension's next tick. At most 100 stacks per call, as
    /// /give. Unknown items or offline players are errors.
    give-item: func(player: string, item: string, count: u32) -> result<_, string>;
}

/// Capability `world`, server mods only (manifest `api = "0.3"`,
/// experimental): the blocks of the server's loaded chunks, and changes to
/// them through the server's own block updates.
interface %world {
    record block-change-pos { x: s32, y: s32, z: s32 }
    record break-options {
        /// Stop before a break that could use the tool's last durability point.
        keep-tool: bool,
        /// Landing position for all drops and experience; none means each block.
        drops-at: option<point>,
        /// Food exhaustion per block, 0..1.
        exhaustion: f32,
    }
    /// API level 20: queue real player breaks, applied after hooks with the live game.
    /// Unknown/offline players or over 2048 positions/call or 4096/mod/tick error atomically.
    /// At apply time skip air, liquids, unloaded blocks, positions beyond 80 blocks,
    /// and unbreakable blocks in survival. Stop if the player leaves or keep-tool triggers.
    /// Uses the normal player path (protection, border, loot, XP, wear, stats and updates).
    /// Creative gives no drops/wear; the caller's block-broken hook is excluded.
    break-blocks-as: func(player: string, blocks: list<block-change-pos>, options: break-options) -> result<_, string>;
    /// A vector or position in blocks, with finite components.
    record point { x: f64, y: f64, z: f64 }
    /// The overworld's world spawn: dimension id, position, angle in degrees.
    spawn-point: func() -> tuple<string, point, f32>;
    /// Drop a plain stack in this dimension, count 1..max stack size.
    /// At most 16 successful requests per tick per mod, across all hook calls.
    spawn-item: func(dimension: string, at: point, item: string, count: u32) -> result<_, string>;
    /// Whether a block id or state belongs to a loaded block tag (without #).
    /// Unknown blocks and tags return false.
    block-has-tag: func(block: string, tag: string) -> bool;
    /// A registered vanilla or loaded content sound in this dimension.
    play-sound: func(dimension: string, at: point, name: string, volume: f32, pitch: f32) -> result<_, string>;
    record block-change {
        x: s32,
        y: s32,
        z: s32,
        /// `minecraft:oak_log[axis=y]`; properties left out take the block's
        /// defaults, `minecraft:stone` alone is the default state.
        state: string,
    }
    record world-time {
        /// The server's shared Overworld dayTime (not reduced modulo 24000).
        day-time: u64,
        game-time: u64,
        /// Level.isBrightOutside: not a fixed-time dimension, sky darkening < 4.
        is-day: bool,
        raining: bool,
        thundering: bool,
    }
    /// A chunk column of a dimension, by chunk coordinates (block x >> 4).
    record chunk-pos {
        dimension: string,
        x: s32,
        z: s32,
    }
    /// The chunks the server generated for the first time during the last
    /// tick (never ones loaded from the save), at most 256, oldest first:
    /// where a mod places its own structures, once per chunk. They are loaded
    /// now, so `get-block` reads them and `set-blocks` changes them.
    generated-chunks: func() -> list<chunk-pos>;
    /// Time and weather in a dimension. Unknown dimensions return zero times
    /// and false flags; known dimensions need not have loaded chunks.
    time: func(dimension: string) -> world-time;
    /// Level.canSeeSky: sky light 15, independent of time, sky darkening or
    /// block light. False for unknown/unloaded chunks and dimensions without skylight.
    can-see-sky: func(dimension: string, x: s32, y: s32, z: s32) -> bool;
    /// The block state at a position in a dimension (`minecraft:overworld`,
    /// ...), as `minecraft:oak_log[axis=y]`, as of this call: none where the
    /// server has no chunk loaded there.
    get-block: func(dimension: string, x: s32, y: s32, z: s32) -> option<string>;
    /// The biome at a position (`minecraft:plains`, ...), as the server
    /// stores it (one per 4 x 4 x 4 cell): none where no chunk is loaded.
    get-biome: func(dimension: string, x: s32, y: s32, z: s32) -> option<string>;
    /// Sets blocks as `/setblock` does: the old block entity removed,
    /// neighbours and shapes updated, light, and every player told. Every
    /// state is checked now (an error queues nothing); the changes are made
    /// in order after this call returns, before that dimension's next tick;
    /// one in a chunk not loaded then is skipped. At most 4096 per call.
    set-blocks: func(dimension: string, blocks: list<block-change>) -> result<_, string>;
    /// Gives the container at a position (a chest, trapped chest, barrel, ...) a loot table,
    /// as a structure's chest has: it is rolled as generated chests are, after this tick's
    /// `set-blocks` (so a chest placed by them gets it). `table` is a loot table id
    /// (`minecraft:chests/simple_dungeon`, a mod's own). Not a container then: nothing.
    set-loot-table: func(dimension: string, x: s32, y: s32, z: s32, table: string) -> result<_, string>;
    /// A plain item stack; components are not carried by this API.
    record item-stack {
        item: string,
        count: u32,
    }
    /// Slots of the block's container; none when it has no container or is unloaded.
    /// This reads one block's slots, including one half of a double chest.
    container: func(dimension: string, x: s32, y: s32, z: s32) -> option<list<option<item-stack>>>;
    /// Replace plain stacks after this tick's block writes, updating open viewers.
    /// The slot count must match; item ids and stack counts are validated.
    /// If the container is absent or its slot count changed when applied, skip it.
    set-container: func(dimension: string, x: s32, y: s32, z: s32, slots: list<option<item-stack>>) -> result<_, string>;
    /// Load a vanilla or mod structure template, as a structure block's LOAD does,
    /// after this tick's block writes, preserving block entities and loot tables.
    /// Rotation is 0..3 clockwise quarter turns; mirror reflects before rotating.
    place-structure: func(dimension: string, id: string, x: s32, y: s32, z: s32, rotation: u32, mirror: bool) -> result<_, string>;
    /// Sets the mob a monster spawner (`minecraft:spawner`) spawns, as a spawn egg
    /// used on it does, after this tick's block writes (so a spawner placed by them
    /// gets it). `entity` is an entity type id, vanilla's or a content mod's. The
    /// spawner keeps its delays, counts and ranges. Not a spawner then, or an
    /// unknown type: nothing, logged.
    set-spawner: func(dimension: string, x: s32, y: s32, z: s32, entity: string) -> result<_, string>;
    /// Current server rule value as text, or none for an unknown rule.
    /// Uses 26.3 names (mob_griefing, minecraft:mob_griefing); mobGriefing is an alias.
    game-rule: func(name: string) -> option<string>;
    /// peaceful, easy, normal or hard, as of the start of this call.
    difficulty: func() -> string;
}

/// Capability `entities`, server mods only (manifest `api = "0.3"`,
/// experimental): the mobs on the server, and orders to the content mods'
/// own (docs/modpacks.md, entities): where to walk, where to look, how to
/// fly, which of their animations to play, and whom their breath hurts.
interface entities {
    /// Accepted damage to content mobs during the last tick.
    record hurt-event {
        victim: u32,
        kind: string,
        attacker-mob: option<u32>,
        attacker-player: option<string>,
        amount: f32,
    }
    /// Content mob's position when it died, before corpse movement/removal.
    record death { id: u32, kind: string, x: f64, y: f64, z: f64 }
    /// Polled last-tick events, at most 256; reading does not consume them.
    hurt-events: func() -> list<hurt-event>;
    /// Content mobs that died last tick, at most 256; reading does not consume them.
    deaths: func() -> list<death>;
    /// Status effects on any loaded mob, including vanilla ones. Zero seconds removes.
    effect: func(mob: u32, change: effect-change) -> result<_, string>;
    /// Set any loaded mob's velocity, as the push order does; each axis -4..4.
    push: func(mob: u32, velocity: point) -> result<_, string>;
    /// Mark any loaded tameable mob (including vanilla horses) tame.
    /// Optional owner is a UUID, including an offline player's; none preserves its owner.
    tame: func(mob: u32, owner: option<string>) -> result<_, string>;
    /// A filtered hurt-area, in the source mob's dimension. WIT requires a
    /// distinct record name from the strike function.
    record strike-hit {
        center: point,
        radius: f64,
        amount: f32,
        fire: u32,
        skip-kinds: list<string>,
        /// Extra vanilla knockback, away from the source mob, strength 0..4.
        knockback: f32,
        /// Online player's UUID: player attack and kill credit; that player is spared.
        credit-player: option<string>,
    }
    /// Source must be a loaded content mob. Radius <=16, damage <=1024,
    /// fire <=30 seconds; skips source and the listed entity types.
    strike: func(mob: u32, hit: strike-hit) -> result<_, string>;
    record entity {
        /// The mob's id on this server while it is loaded.
        id: u32,
        /// `minecraft:zombie`, `ruby:golem`, ...
        kind: string,
        /// `minecraft:overworld`, ...
        dimension: string,
        /// Feet position, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// Where its body faces, vanilla's yaw in degrees (0 south, 90 west).
        yaw: f32,
        health: f32,
        max-health: f32,
        on-ground: bool,
        /// The mob it attacks, by id; none for no mob (a player, or none).
        target: option<u32>,
        /// It attacks a player: the nearest it sees or one selected by UUID.
        target-player: bool,
        /// Its `minecraft:scale`: 1 is its type's size.
        scale: f32,
        /// What mods stored on it (`set-data`, `spawn`), kept in its save.
        data: list<tuple<string, string>>,
        /// Ticks it has lived since it was loaded.
        age: u32,
        /// The animation an `animate` order plays on it now.
        animation: option<string>,
        /// The per-mob texture override; none uses its type's texture.
        texture: option<string>,
        /// The player riding it, if one does (seated by `mount`), and that
        /// player's input this tick.
        rider: option<rider>,
    }
    /// A player riding a mob, and the keys and look they steer with.
    record rider {
        /// The player's UUID, as `players.online` has it.
        player: string,
        /// 1 forward, -1 back, 0 neither (the movement keys or stick).
        forward: f32,
        /// 1 left, -1 right, 0 neither.
        strafe: f32,
        /// The jump key is held.
        jumping: bool,
        /// The sprint key is held, or the player sprints.
        sprinting: bool,
        /// Where the player looks, vanilla's yaw and pitch in degrees.
        yaw: f32,
        pitch: f32,
    }
    /// Seat a player on a mob.
    record mount {
        /// That online player's UUID: in the mob's dimension, within 16 blocks,
        /// alive and not riding anything.
        player: string,
        /// Seat height above the mob's feet, -16 to 64 blocks.
        height: f32,
        /// Seat distance ahead of the mob's middle along its yaw, -32 to 32.
        forward: f32,
    }
    record point {
        x: f64,
        y: f64,
        z: f64,
    }
    record walk {
        to: point,
        /// A multiple of its movement speed, 0 to 4.
        speed: f64,
    }
    record area {
        /// The centre of a ball, in the mob's dimension.
        center: point,
        /// Its radius in blocks, at most 16.
        radius: f64,
        /// Hit points every living thing in it but the mob loses (vanilla's
        /// `mob_attack` damage from the mob), at most 1024.
        amount: f32,
        /// Seconds those not immune to fire burn after, at most 30.
        fire: u32,
    }
    record attribute-change {
        /// max_health, movement_speed, flying_speed, attack_damage,
        /// attack_knockback, armor, armor_toughness, knockback_resistance,
        /// follow_range or step_height (as in entity JSON).
        name: string,
        /// Base value, 0 to 1024; vanilla's attribute bounds limit its effective value.
        value: f64,
    }
    record effect-change {
        /// A registered effect id, such as minecraft:slowness.
        id: string,
        /// Duration in seconds; zero removes this effect.
        seconds: u32,
        amplifier: u8,
    }
    record sound {
        /// A vanilla sound event id or a loaded mod's sounds.json event.
        name: string,
        volume: f32,
        pitch: f32,
    }
    record particles {
        /// A vanilla particle type with no options.
        name: string,
        /// Position in the mob's dimension.
        at: point,
        delta: point,
        speed: f32,
        /// At most 256; zero sends one with delta * speed as its velocity.
        count: u32,
    }
    /// A player's right click on a content mod's mob.
    record interaction {
        /// The player's UUID, as `players.online` has it.
        player: string,
        mob: u32,
        kind: string,
        /// What the player held in the hand they used, `minecraft:beef`, ...
        item: option<string>,
        /// The player's shift key at the time of the click.
        sneaking: bool,
        /// main_hand or off_hand: the hand that clicked.
        hand: string,
    }
    /// Whom a mob attacks.
    variant target {
        none,
        /// A mob, by id.
        mob(u32),
        /// The nearest player it sees.
        nearest-player,
        /// That online player's UUID, even when another player is nearer.
        /// Dropped if the player leaves the level or becomes untargetable.
        player(string),
    }
    variant order {
        /// Walk to a point by its path navigation, ahead of its own goals,
        /// until it arrives or gets another order to walk or `halt`.
        walk-to(walk),
        /// Stop walking and looking where orders said: its goals take over.
        halt,
        /// Turn its head toward a point until another order.
        look-at(point),
        /// Set its motion in blocks per tick, each axis -4 to 4: flight,
        /// leaps and dives.
        push(point),
        /// Whether gravity pulls it (false: it stays where it is pushed).
        gravity(bool),
        /// Play one of the animations of its own model's animation file,
        /// from its start (a looping one loops); none: back to its states'
        /// (idle, walk, attack). Players' games see it too.
        animate(option<string>),
        /// A loaded mod's <namespace>:entity/<path> texture; none restores
        /// the type's texture. Saved on the mob and sent to every player.
        texture(option<string>),
        /// Play a sound at the mob, within 16 * max(1, volume) blocks.
        sound(sound),
        /// Send particles to players within 32 blocks, in the mob's dimension.
        particles(particles),
        /// Hurt and burn what is in an area: a breath, a stomp.
        hurt-area(area),
        /// Remove it, with no drops (`Entity.discard`).
        discard,
        /// Have it attack, as its own goals do: its template's attacks
        /// (melee, arrows, ...) on that target.
        target(target),
        /// Its `minecraft:scale`, 0.0625 to 16: growth. Its size and model
        /// follow, on every player's game.
        scale(f32),
        /// Set a base attribute, kept in vanilla's saved attributes list.
        /// Raising max_health does not heal; lowering it clamps health.
        attribute(attribute-change),
        /// LivingEntity.heal: add a finite amount, clamped to 0..max health,
        /// only while health is positive (never revives a dead mob).
        heal(f32),
        /// Apply a registered status effect; zero seconds removes it.
        effect(effect-change),
        /// Seat that player on it, at that seat (moved with later `mount`
        /// orders for the same player). The player gets off as from any
        /// mount (sneaking) or on `dismount`; the mob does not move by itself
        /// for the rider: the mod moves it from `rider`'s input.
        mount(mount),
        /// Let its rider off, beside it.
        dismount,
        /// Store strings on it, kept in its save: a key (1 to 64 characters)
        /// to a value (up to 1024), none removes the key. At most 32 keys.
        set-data(list<tuple<string, option<string>>>),
    }
    /// The loaded mobs of content mods' kinds (any namespace but
    /// `minecraft`), as at the start of the tick, at most 1024.
    mobs: func() -> list<entity>;
    /// Every loaded mob within `radius` (at most 64) blocks of a point in a
    /// dimension, nearest first, at most 256. Players are
    /// `players.online`'s.
    near: func(dimension: string, at: point, radius: f64) -> list<entity>;
    /// The right clicks players made on content mods' mobs during the last
    /// tick, in order, at most 256: feeding, taming, mounting are the mod's
    /// to decide. The game's own use of the click (a lead, a name tag) still
    /// happens.
    interactions: func() -> list<interaction>;
    /// Orders, by mob id, to content mods' mobs: checked now (an error
    /// queues none) and carried out in order before their dimension's next
    /// tick; an order to a mob gone by then is dropped. At most 1024 per
    /// call.
    give-orders: func(orders: list<tuple<u32, order>>) -> result<_, string>;
    /// Spawns a content mod's mob (any namespace but `minecraft`) at a
    /// point of a dimension, facing `yaw`, persistent, with `data` stored on
    /// it (as `set-data`), before that dimension's next tick: `mobs` lists
    /// it from the tick after, where `data` tells it apart. At most 64 spawns
    /// per hook call; an unknown kind is an error.
    spawn: func(kind: string, dimension: string, at: point, yaw: f32, data: list<tuple<string, string>>) -> result<_, string>;
    /// Seats a content mod's mob on another loaded mob (`Entity.startRiding`,
    /// as `/ride` does), or with no vehicle lets it off (`stopRiding`). Checked
    /// now: both loaded in one dimension, within 16 blocks, not the same mob,
    /// and no loop of riders. Carried out with the tick's orders, unless by then
    /// the vehicle carries another mob or a player, or either is gone. The
    /// rider then sits on the vehicle, which walks and fights as before; it is
    /// saved riding (`Passengers`) and every player sees it.
    ride: func(rider: u32, vehicle: option<u32>) -> result<_, string>;
    /// The mob or boat a loaded mob rides, as at the start of the tick.
    vehicle: func(id: u32) -> option<u32>;
}

/// What the server calls in a server mod (manifest `api = "0.3"`,
/// experimental). Only the hooks `init` asks for are ever called. The player
/// in each event is as the server saw them when it happened.
interface server-events {
    use players.{player};

    record block-pos {
        x: s32,
        y: s32,
        z: s32,
    }
    /// What an argument of a command takes. The server sends each command
    /// and its arguments to players' games, whose chat box completes and
    /// colours them as vanilla's; the server parses them before the mod's
    /// `command` hook gets their values.
    variant argument-kind {
        /// One word: letters, digits and `_ - . +`.
        word,
        /// The rest of the line, spaces included: only last.
        text,
        /// A whole number, within the bounds given.
        integer(tuple<option<s32>, option<s32>>),
        /// A number with or without decimals.
        number,
        /// `true` or `false`.
        boolean,
        /// One online player: a name, or `@s` or `@p` (whoever typed it,
        /// as vanilla picks for a player).
        player,
        /// A block position: three whole numbers, each one also `~` or
        /// `~n`, relative to whoever typed it.
        block-pos,
    }
    record argument {
        /// Shown in the chat box's hint (`<height>`) and the key of its value.
        name: string,
        kind: argument-kind,
        /// Optional arguments come after every required one.
        optional: bool,
    }
    record server-command {
        /// Without the slash. A name vanilla already uses is refused
        /// (vanilla's command runs).
        name: string,
        /// In order; none: the command takes nothing after its name. Free
        /// text is one optional `text` argument.
        arguments: list<argument>,
    }
    /// An argument's value, parsed as its kind says.
    variant argument-value {
        word(string),
        text(string),
        integer(s32),
        number(f64),
        boolean(bool),
        player(player),
        block-pos(block-pos),
    }
    record registration {
        /// Commands players may type.
        commands: list<server-command>,
        /// Call `tick` every server tick (20 per second).
        tick: bool,
        /// Call `player-joined` and `player-left`.
        joins: bool,
        /// Call `chat` for each chat message a player sends.
        chat: bool,
        /// Call `block-broken` and `block-placed`.
        blocks: bool,
    }
    /// Once, after loading. An error keeps the mod off and is logged.
    init: func() -> result<registration, string>;
    /// Each server tick, with the server's tick counter.
    tick: func(tick: u64);
    /// A player joined the server; they are in `players.online` already.
    player-joined: func(player: player);
    /// A player left the server; they are no longer in `players.online`.
    player-left: func(player: player);
    /// A chat message a player sent, as plain text.
    chat: func(player: player, text: string);
    /// `/name args` typed by `player`: ok(some(text)) is their feedback,
    /// err(text) their error in red. `values` holds each argument given, by
    /// name, in order (an optional one left out isn't there); a line that
    /// doesn't parse never reaches the mod: the player gets vanilla's error.
    command: func(player: player, name: string, args: string, values: list<tuple<string, argument-value>>) -> result<option<string>, string>;
    /// A player broke the block at `pos` in their dimension: `state` is what
    /// was there, as `minecraft:oak_log[axis=y]`.
    block-broken: func(player: player, pos: block-pos, state: string);
    /// A player placed `state` at `pos` in their dimension.
    block-placed: func(player: player, pos: block-pos, state: string);
}

/// A client mod: runs in the player's game.
world horizon-mod {
    import log;
    import game;
    import chat;
    import hud;
    import storage;
    import command;
    export events;
}

/// A server mod (manifest `side = "server"`, `api = "0.3"`, experimental):
/// runs where the world is simulated, on the dedicated server, a LAN host
/// and single player's own server.
world horizon-server-mod {
    import log;
    import storage;
    import players;
    import %world;
    import entities;
    export server-events;
}

/// A mod with widgets (capability `ui`): the SDK builds every mod against
/// this world. Mods built for `horizon-mod` alone (no `ui-events` export)
/// still load and simply hear nothing of their widgets.
world horizon-ui-mod {
    include horizon-mod;
    import ui;
    import render;
    import input;
    import recipes;
    import browser;
    import browser-ext;
    import canvas;
    import client-world;
    export ui-events;
    import container;
    export container-events;
}

/// The game's side of `horizon-ui-mod` beyond `horizon-mod`.
world ui-host {
    import ui;
    export ui-events;
}

/// The game's side of capability `render` (imports only).
world render-host {
    import render;
    import input;
    import canvas;
}

/// The game's side of capability `world-read` (imports only).
world world-read-host {
    import client-world;
}

/// The game's side of capability `recipes` (imports only).
world recipes-host {
    import recipes;
    import browser;
    import browser-ext;
}

/// The game's additive container imports and optional exports.
world container-host {
    import container;
    export container-events;
}
